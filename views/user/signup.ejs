<% layout("/layouts/boilerplate") %>

<div class="row mt-3 ">
    <div class="col-6  offset-2">
        <h1 class="col-6 offset-3"> SignUp on wanderlust </h1>

       <form action="/signup"  method="post"  class="needs-validation" novalidate>

    <div class="mb-3">
        <label for="username" class="form-label">username</label>
        <input name="username" id="username" class="form-control" required>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">enter valid username</div>
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">email</label>
        <input name="email" id="email" class="form-control" required>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">enter valid email</div>
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">password</label>
        <input name="password" id="password" class="form-control"  type="password"   required>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">enter valid password</div>
    </div>

     <button class="btn btn-success" >Sign Up</button>
      </form>
        
    </div>
</div>
